        "jsCode": "// ─────────────────────────────────────────────\n// RAPHA HOSPITAL — Appointment Booking\n// Code Node v3.0 | Production\n// Handles: Tally form + Website form\n// ─────────────────────────────────────────────\n\nconst body = $json.body;\n\n// Detect source — website sends flat JSON, Tally sends nested fields\nconst isWebsite = body.source === 'website';\n\n// ── Tally extractors ──────────────────────────\nconst fields = isWebsite ? null : body.data.fields;\n\nfunction getText(index) {\n  try {\n    const val = fields[index].value;\n    return val !== undefined && val !== null && String(val).trim() !== ''\n      ? String(val).trim() : 'Not provided';\n  } catch (e) { return 'Not provided'; }\n}\n\nfunction getDropdown(index) {\n  try {\n    const field = fields[index];\n    const selectedId = field.value[0];\n    const match = field.options.find(opt => opt.id === selectedId);\n    return match ? match.text.trim() : 'Not provided';\n  } catch (e) { return 'Not provided'; }\n}\n\n// ── Website extractors ────────────────────────\nfunction getWebsite(key) {\n  try {\n    const val = body[key];\n    return val !== undefined && val !== null && String(val).trim() !== ''\n      ? String(val).trim() : 'Not provided';\n  } catch (e) { return 'Not provided'; }\n}\n\n// ── Timestamp ─────────────────────────────────\nconst now = new Date();\nconst timestamp = now.toLocaleString('en-IN', {\n  timeZone: 'Asia/Kolkata',\n  day: '2-digit', month: '2-digit', year: 'numeric',\n  hour: '2-digit', minute: '2-digit', hour12: true\n});\n\n// ── Extract fields based on source ────────────\nconst patientName    = isWebsite ? getWebsite('patientName')    : getText(0);\nconst phoneNumber    = isWebsite ? getWebsite('phoneNumber')    : getText(1);\nconst age            = isWebsite ? getWebsite('age')            : getText(2);\nconst gender         = isWebsite ? getWebsite('gender')         : getDropdown(3);\nconst reasonForVisit = isWebsite ? getWebsite('reasonForVisit') : getDropdown(4);\nconst preferredTime  = isWebsite ? getWebsite('preferredTime')  : getDropdown(5);\nconst source         = isWebsite ? 'Website' : 'Tally Form';\n\n// ── Return clean output ───────────────────────\nreturn {\n  timestamp,\n  patientName,\n  phoneNumber,\n  age,\n  gender,\n  reasonForVisit,\n  preferredTime,\n  source,\n  status: 'Pending'\n};"
      },
